# ---- Pipeline artefacts -------------------------------------------------
# Docking inputs/outputs are regenerated by step_04; they are large and
# machine-specific, so they do not belong in version control.
# Generated ligand conformers (1618 files, regenerated by the prep step).
*.pdbqt
step_04_hit_selection/docking/ligands/
# ...but the prepared receptor IS an input: docking cannot be reproduced
# without it, so it stays in version control.
!step_04_hit_selection/docking/3ANQ_receptor.pdbqt
step_04_hit_selection/docking/out/
step_04_hit_selection/docking/logs/

# Descriptor matrices are rebuilt by step_02 from the raw ChEMBL dump.
step_02_activity_prediction/results/descriptors.parquet
step_02_activity_prediction/results/descriptors_filtered.parquet

# Model checkpoints
*.pt
*.pth
*.ckpt
